{
  "name": "@unids/react",
  "version": "0.0.0",
  "description": "uniDS React components + Storybook.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix ../../design-tokens run build",
    "build": "tsc -p tsconfig.build.json && vite build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm --prefix ../../design-tokens run build",
    "build-storybook": "storybook build -o storybook-static",
    "postbuild-storybook": "node -e \"require('fs').cpSync('storybook-static','../../storybook-static',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@unids/tokens": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-themes": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
